<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same as st_backup_rules.xml, for cloud backups and phone-to-phone transfers. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="trueline.screentime.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="trueline.screentime.xml" />
  </device-transfer>
</data-extraction-rules>
